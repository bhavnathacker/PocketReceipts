<?xml version="1.0" encoding="utf-8"?>
<!--
    The only module allowed to add INTERNET (enforced by verifyInternetPermissionSources):
    DownloadManager needs it to download the on-device model. No receipt data is
    ever sent.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

</manifest>
