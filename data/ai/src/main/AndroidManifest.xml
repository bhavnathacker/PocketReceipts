<?xml version="1.0" encoding="utf-8"?>
<!--
    LiteRT-LM's GPU backend needs the device's OpenCL library. They are optional:
    without them the runtime falls back to the CPU backend.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <uses-native-library
            android:name="libvndksupport.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
    </application>

</manifest>
