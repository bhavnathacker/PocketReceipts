<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        ML Kit's usage-log upload backend (transport-backend-cct) declares INTERNET.
        Only :data:model-download may add INTERNET, so it is removed here.
        verifyInternetPermissionSources accepts the backend's declaration only
        because of this removal. Never delete it.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <application
        android:name=".PocketReceiptsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketReceipts">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PocketReceipts"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Switches off ML Kit's usage logging: without this backend registration,
            the data-transport runtime drops ML Kit's usage events on the device.
            ML Kit still needs the backend's classes, so the library stays.
            verifyNoUsageLoggingBackend fails if the registration comes back.
            Never delete this. (Lint can't see the service class: it is only on the
            runtime classpath, through ML Kit.)
        -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:ignore="MissingClass"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>
    </application>

</manifest>